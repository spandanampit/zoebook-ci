    ajax_media: function (postid, mediaid) {
        var params = {
            posted_postid: postid,
            posted_mediaid: mediaid,
            pagefrom: 'changemedia'
        }
        Project.showUILoader($("#feed_id_" + postid), {style: 'black', message: 'Loading.. Please Wait..'});
        $.ajax({
            url: site_url + 'home/feed_change_media',
            type: 'POST',
            data: params,
            dataType: 'json',
            success: function (response) {
                Project.hideUILoader($("#feed_id_" + postid));
                $("#feed_action_" + postid).html(response.feed_actions);
                $("#comments_list_" + postid).html(response.comments);
            },
            error: function (e) {
                Project.hideUILoader($("#feed_id_" + postid));
            }
        });
    },
    checkValid: function () {
        var page_type = $("#page_type").val();
        if (page_type == "my_profile") {
            var post_text = $("#post_text").val();
            if ($.trim(post_text) == "") {
                $("#submit_edit_post").prop("disabled", true);
                //$("#post_text").focus();
            } else {
                $("#submit_edit_post").removeAttr("disabled");
            }
        } else {
            var post_text = $("#post_text").val();
            if ($.trim(post_text) == "") {
                $("#submit_post").prop("disabled", true);
                $("#post_text").focus();
            } else {
                $("#submit_post").removeAttr("disabled");
            }
        }
    },
