 * 
 * @since 13.10.2022
 */ 
 
class Post_list extends Cit_Controller
{
    public $settings_params;
    public $output_params;
    public $single_keys;
    public $multiple_keys;
    public $block_result;
      
    /**
     * __construct method is used to set controller preferences while controller object initialization.
     */
    public function __construct() {
        parent::__construct();
        $this->settings_params = array();
        $this->output_params = array();
        $this->single_keys = array("prepare_my_post_id_list","prepare_user_post_id_list","update_myfeedupdatedate_users");
        $this->multiple_keys = array("get_my_posts","get_my_post_comment_stats","get_my_post_like_stats","get_my_post_share_stats","assign_my_post_statistics","fetch_post_id","get_my_post_media","get_user_posts","get_user_post_comment_stats","get_user_post_like_stats","get_user_post_share_stats","assign_user_post_statistics","custom_fetch_user_post_id","get_user_post_media","custom_add_ads_user_post");
        $this->block_result = array();

        $this->load->library('wsresponse');
        $this->load->model('post_list_model');
        $this->load->model("post/post_model");
    $this->load->model("wscustom/wscustom_model");
    $this->load->model("post/post_media_model");
    $this->load->model("user/users_model");
    }
      
    /**
     * rules_post_list method is used to validate api input params.
     * @created Vamsi Ippe | 19.09.2018
     * @modified Jay Rajput | 13.10.2022
     * @param array $request_arr request_arr array is used for api input.
     * @return array $valid_res returns output response of API.
     */
    public function rules_post_list($request_arr = array()){
        $valid_arr = array(
                "is_feed" => array(
                    array(
                        "rule" => "required",
                        "value" => TRUE,
                        "message" => "is_feed_required"
                    )
                ),
                "profile_user_id" => array(
                    array(
                        "rule" => "required",
                        "value" => TRUE,
                        "message" => "profile_user_id_required"
                    )
                ),
                "user_id" => array(
                    array(
                        "rule" => "required",
                        "value" => TRUE,
                        "message" => "user_id_required"
                    )
                )
            );
        $valid_res = $this->wsresponse->validateInputParams($valid_arr, $request_arr, "post_list");
        
        return $valid_res;
    }
    
    /**
     * start_post_list method is used to initiate api execution flow.
     * @created Vamsi Ippe | 19.09.2018
     * @modified Jay Rajput | 13.10.2022
     * @param array $request_arr request_arr array is used for api input.
     * @param bool $inner_api inner_api flag is used to idetify whether it is inner api request or general request.
     * @return array $output_response returns output response of API.
     */
    public function start_post_list($request_arr  = array(), $inner_api = FALSE) {
        try {
            $validation_res = $this->rules_post_list($request_arr);
            if ($validation_res["success"] == "-5") {
                if($inner_api === TRUE){
                    return $validation_res;
                } else {
                    $this->wsresponse->sendValidationResponse($validation_res);
                }
            }
            $output_response = array();
            $input_params = $validation_res['input_params'];
            
        
        $condition_res = $this->cond_check_user_id($input_params);
        
        if($condition_res["success"]) {
        
    
        $input_params = $this->get_my_posts($input_params);
        
    
        $condition_res = $this->is_having_my_posts($input_params);
        
        if($condition_res["success"]) {
        
    
        $input_params = $this->prepare_my_post_id_list($input_params);
        
    
        $input_params = $this->get_my_post_comment_stats($input_params);
        
    
        $input_params = $this->get_my_post_like_stats($input_params);
        
    
        $input_params = $this->get_my_post_share_stats($input_params);
        
    
        $input_params = $this->assign_my_post_statistics($input_params);
        
    
        }
    
        $input_params = $this->fetch_post_id($input_params);
        
    
        $input_params = $this->get_my_post_media($input_params);
        
    
        $input_params = $this->start_loop($input_params);
        
    
        $input_params = $this->custom_function($input_params);
        
    
        $input_params = $this->update_myfeedupdatedate($input_params);
        
    
        $input_params = $this->custom_function_1($input_params);
        
    
        $condition_res = $this->condition_check($input_params);
        
        if($condition_res["success"]) {
        
    
        $output_response = $this->post_finish_success_2($input_params);
        return $output_response;
        
    
        }
    
        else {
        
    
        $output_response = $this->post_finish_success_3($input_params);
        return $output_response;
        
    
        }
        
    
        }
    
        else {
        
    
        $input_params = $this->get_user_posts($input_params);
        
    
        $condition_res = $this->is_having_user_posts($input_params);
        
        if($condition_res["success"]) {
        
    
        $input_params = $this->prepare_user_post_id_list($input_params);
        
    
        $input_params = $this->get_user_post_comment_stats($input_params);
        
    
        $input_params = $this->get_user_post_like_stats($input_params);
        
    
        $input_params = $this->get_user_post_share_stats($input_params);
        
    
        $input_params = $this->assign_user_post_statistics($input_params);
        
    
        }
    
        $input_params = $this->custom_fetch_user_post_id($input_params);
        
    
        $input_params = $this->get_user_post_media($input_params);
        
    
        $input_params = $this->start_loop_1($input_params);
        
    
        $input_params = $this->update_myfeedupdatedate_users($input_params);
        
    
        $input_params = $this->custom_add_ads_user_post($input_params);
        
    
        $condition_res = $this->condition_for_user_posts($input_params);
        
        if($condition_res["success"]) {
        
    
        $output_response = $this->post_finish_success($input_params);
        return $output_response;
        
    
        }
    
        else {
        
    
        $output_response = $this->post_finish_success_1($input_params);
        return $output_response;
        
    
        }
        
    
        }
        
        
        } catch (Exception $e) {
            $message = $e->getMessage();
        }
        return $output_response;
    }
    

    /**
     * cond_check_user_id method is used to process conditions.
     * @created Vamsi Ippe | 19.09.2018
     * @modified Vamsi Ippe | 19.09.2018
     * @param array $input_params input_params array to process condition flow.
     * @return array $block_result returns result of condition block as array.
     */
    public function cond_check_user_id($input_params = array())
    {
        
            $this->block_result = array();
            try {
                
            $cc_lo_0 = $input_params["user_id"];
            $cc_ro_0 = $input_params["profile_user_id"];
            
            $cc_fr_0 = ($cc_lo_0 == $cc_ro_0) ? TRUE : FALSE;    
            
            if(!$cc_fr_0){
                throw new Exception("Some conditions does not match.");
            }
                $success = 1;
                $message = "Conditions matched.";
            } catch (Exception $e) {
                $success = 0;
                $message = $e->getMessage();
            }
            $this->block_result["success"] = $success;
            $this->block_result["message"] = $message;
            return $this->block_result;
            
    }
                                
    /**
     * get_my_posts method is used to process query block.
     * @created Vamsi Ippe | 19.09.2018
     * @modified Jay Rajput | 22.08.2022
     * @param array $input_params input_params array to process loop flow.
     * @return array $input_params returns modfied input_params array.
     */
    public function get_my_posts($input_params = array())
    {
        
            $this->block_result = array();
            try {
                
            $params_arr = array();
            if(isset($input_params["user_id"])){
                $params_arr["user_id"] = $input_params["user_id"];
            }
            if(isset($input_params["is_feed"])){
                $params_arr["is_feed"] = $input_params["is_feed"];
            }
            $page_index = isset($input_params["page_index"]) ? $input_params["page_index"] : 1;
            $this->block_result = $this->post_model->get_my_posts($params_arr, $page_index, $this->settings_params);
            
            if(!$this->block_result["success"]){
                throw new Exception("No records found.");
            }
            $result_arr = $this->block_result["data"];
            if(is_array($result_arr) && count($result_arr) > 0){
                $i = 0;
                foreach($result_arr as $data_key => $data_arr){
                    
                    $data = $data_arr["p_added_date"];
                    if (method_exists($this->general, "dateTimeSystemFormat")) {
                        $data = $this->general->dateTimeSystemFormat($data, $result_arr[$data_key], $i, $input_params);
                    }
                    $result_arr[$data_key]["p_added_date"] = $data;
                    
                    $data = $data_arr["u_profile_image"];
                    $image_arr = array();                        
                    $image_arr["image_name"] = $data;
                    $image_arr["ext"] = implode(",", $this->config->item("IMAGE_EXTENSION_ARR"));
                    $image_arr["def_img"] = "Yes";
                    $image_arr["path"] = "compress_profile_image";
                    $data = $this->general->get_image_aws($image_arr);
                    
                    $result_arr[$data_key]["u_profile_image"] = $data;
                    
                    $data = $data_arr["p_video_thumbnail"];
                    $image_arr = array();                        
                    $image_arr["image_name"] = $data;
                    $image_arr["ext"] = implode(",", $this->config->item("IMAGE_EXTENSION_ARR"));
                    $image_arr["def_img"] = "Yes";
                    $dest_path = "thumbnail";
                    $image_arr["path"] = $this->general->getImageNestedFolders($dest_path);
                    $data = $this->general->get_image($image_arr);
                    
                    $result_arr[$data_key]["p_video_thumbnail"] = $data;
                    
                    $data = $data_arr["post_detail_url"];
                    if (method_exists($this, "post_detail_url")) {
                        $data = $this->post_detail_url($data, $result_arr[$data_key], $i, $input_params);
                    }
                    $result_arr[$data_key]["post_detail_url"] = $data;
                    
                    $i++;
                }
                $this->block_result["data"] = $result_arr;
            }
            
            } catch (Exception $e) {
                $success = 0;
                $this->block_result["data"] = array();
            }
            $input_params["get_my_posts"] = $this->block_result["data"];
            
        return $input_params;
    }

    /**
     * is_having_my_posts method is used to process conditions.
     * @created  | 06.09.2019
     * @modified  | 06.09.2019
     * @param array $input_params input_params array to process condition flow.
     * @return array $block_result returns result of condition block as array.
     */
    public function is_having_my_posts($input_params = array())
    {
        
            $this->block_result = array();
            try {
                
            $cc_lo_0 = (empty($input_params["get_my_posts"]) ? 0 : 1);
            $cc_ro_0 = 1;
            
            $cc_fr_0 = ($cc_lo_0 == $cc_ro_0) ? TRUE : FALSE;    
            
            if(!$cc_fr_0){
                throw new Exception("Some conditions does not match.");
            }
                $success = 1;
                $message = "Conditions matched.";
            } catch (Exception $e) {
                $success = 0;
                $message = $e->getMessage();
            }
            $this->block_result["success"] = $success;
            $this->block_result["message"] = $message;
            return $this->block_result;
            
    }
                                
    /**
     * prepare_my_post_id_list method is used to process custom function.
     * @created  | 06.09.2019
     * @modified  | 09.09.2019
     * @param array $input_params input_params array to process loop flow.
     * @return array $input_params returns modfied input_params array.
     */
    public function prepare_my_post_id_list($input_params = array())
    {
                    
            if (!method_exists($this, "getMyPostIDList")) {
                $result_arr["data"] = array();
            } else {
                $result_arr["data"] = $this->getMyPostIDList($input_params);
            }
            $format_arr = $result_arr;
            
            $format_arr = $this->wsresponse->assignFunctionResponse($format_arr);
            $input_params["prepare_my_post_id_list"] = $format_arr;
            
            $input_params = $this->wsresponse->assignSingleRecord($input_params, $format_arr);
        return $input_params;
    }
                                
