    /**
     * iterate_start_loop method is used to iterate loop.
     * @created Jay Rajput | 08.09.2022
     * @modified Jay Rajput | 08.09.2022
     * @param array $get_my_posts_lp_arr get_my_posts_lp_arr array to iterate loop.
     * @param array $input_params_addr $input_params_addr array to address original input params.
     */
    public function iterate_start_loop(&$get_my_posts_lp_arr = array(), &$input_params_addr = array())
    {
        
         
        $input_params_loc = $input_params_addr;
        $_loop_params_loc = $get_my_posts_lp_arr;
        $_lp_ini = 0;
        $_lp_end = count($_loop_params_loc);
        for ($i = $_lp_ini; $i < $_lp_end; $i += 1) {
            $get_my_posts_lp_pms = $input_params_loc;
            
            unset($get_my_posts_lp_pms["get_my_posts"]);
            if(is_array($_loop_params_loc[$i])){
                $get_my_posts_lp_pms = $_loop_params_loc[$i] + $input_params_loc;
            } else {
                $get_my_posts_lp_pms["get_my_posts"] = $_loop_params_loc[$i];
                $_loop_params_loc[$i] = array();
                $_loop_params_loc[$i]["get_my_posts"] = $get_my_posts_lp_pms["get_my_posts"];
            }
            
            $get_my_posts_lp_pms["i"] = $i;
            $input_params = $get_my_posts_lp_pms;
            
        $condition_res = $this->check_post_type($input_params);
        
        if($condition_res["success"]) {
        
    
        $input_params = $this->get_actual_post($input_params);
        
    
        $input_params = $this->get_actual_post_statistics($input_params);
        
    
        $input_params = $this->assign_actual_post_stats($input_params);
        
    
        $input_params = $this->get_actual_post_media($input_params);
        
    
        }
            
    
            
            $get_my_posts_lp_arr[$i] = $this->wsresponse->filterLoopParams($input_params, $_loop_params_loc[$i], $get_my_posts_lp_pms);
        }
        
    }

    /**
     * iterate_start_loop_1 method is used to iterate loop.
     * @created Jay Rajput | 08.09.2022
     * @modified Jay Rajput | 08.09.2022
     * @param array $get_user_posts_lp_arr get_user_posts_lp_arr array to iterate loop.
     * @param array $input_params_addr $input_params_addr array to address original input params.
     */
    public function iterate_start_loop_1(&$get_user_posts_lp_arr = array(), &$input_params_addr = array())
    {
        
         
        $input_params_loc = $input_params_addr;
        $_loop_params_loc = $get_user_posts_lp_arr;
        $_lp_ini = 0;
        $_lp_end = count($_loop_params_loc);
        for ($i = $_lp_ini; $i < $_lp_end; $i += 1) {
            $get_user_posts_lp_pms = $input_params_loc;
            
            unset($get_user_posts_lp_pms["get_user_posts"]);
            if(is_array($_loop_params_loc[$i])){
                $get_user_posts_lp_pms = $_loop_params_loc[$i] + $input_params_loc;
            } else {
                $get_user_posts_lp_pms["get_user_posts"] = $_loop_params_loc[$i];
                $_loop_params_loc[$i] = array();
                $_loop_params_loc[$i]["get_user_posts"] = $get_user_posts_lp_pms["get_user_posts"];
            }
            
            $get_user_posts_lp_pms["i"] = $i;
            $input_params = $get_user_posts_lp_pms;
            
        $condition_res = $this->check_user_post($input_params);
        
        if($condition_res["success"]) {
        
    
        $input_params = $this->get_user_actual_post($input_params);
        
    
        $input_params = $this->get_user_actual_post_statistics($input_params);
        
    
        $input_params = $this->assign_user_actual_post_stats($input_params);
        
    
        $input_params = $this->get_uesr_post_media($input_params);
        
    
        }
            
    
            
            $get_user_posts_lp_arr[$i] = $this->wsresponse->filterLoopParams($input_params, $_loop_params_loc[$i], $get_user_posts_lp_pms);
        }
        
    }
}