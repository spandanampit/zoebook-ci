<?php  
            
defined('BASEPATH') || exit('No direct script access allowed');

/**
 * Description of Post List Controller
 * 
 * @category webservice
 *            
 * @package post
 * 
 * @subpackage controllers 
 * 
 * @module Post List
 * 
 * @class Post_list.php
 * 
 * @path application\webservice\post\controllers\Post_list.php
 * 
 * @version 4.3
 *
