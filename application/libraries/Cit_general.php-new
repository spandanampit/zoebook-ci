    public function array_random ($array, $amount = 1) {
    $keys = array_rand($array, $amount);
if ($amount == 1) {
  return $array[$keys];
}
$results = [];
foreach ($keys as $key) {
    $results[] = $array[$key];
}
return $results;
}
